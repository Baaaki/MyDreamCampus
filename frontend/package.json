    "@vitejs/plugin-react": "^6",
    "@vitest/ui": "^5",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "jsdom": "^30",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8",
    "vitest": "^5"
