# Backend API base URL (the Caddy edge from docker compose).
# Must start with EXPO_PUBLIC_ to be bundled into the app.
#
# Optional in development: left unset, the app talks to port 80 of the
# machine Metro runs on — the address Expo Go or the dev client already
# reaches, so a new DHCP lease needs no edit here. Set it only when the
# backend runs somewhere else. Release APKs get theirs from
# scripts/build-apk.sh.
#
# EXPO_PUBLIC_API_URL=http://192.168.1.42/api
# EXPO_PUBLIC_API_URL=https://mydreamcampus.madebybaki.com/api
