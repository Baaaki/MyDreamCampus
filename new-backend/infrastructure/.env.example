# Copy to .env and fill in. `make deploy` reads this file automatically.
#
# Generate every secret with:  openssl rand -base64 48
# Every service runs with ENVIRONMENT=production and REFUSES to start if any
# secret is left at its default value.

# --- Postgres (superuser of the one shared instance) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Shared password of the per-service DB roles (auth_svc, staff_svc, ...).
# One password on purpose: isolation comes from the per-database CONNECT grant,
# not from the password — auth_svc cannot open the catalog database anyway.
# Generate this one with `openssl rand -hex 32`, NOT base64: it is interpolated
# into a postgres:// DSN, where base64's `/` would end the authority section.
SERVICE_DB_PASSWORD=CHANGE_ME_service_db_password

# --- Redis (token blacklist / rate limit) ---
# Must NOT be the literal "changeme_redis_secret" in production.
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- RabbitMQ ---
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# --- App secrets (each 32+ bytes; openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_bytes
INTERNAL_SERVICE_SECRET=CHANGE_ME_internal_secret_min_32_bytes
QR_SECRET=CHANGE_ME_qr_secret_min_32_bytes

# --- Infra host ports (only for reaching them FROM the host) ---
# Set one of these when the machine already runs something on that port. The
# stack itself is unaffected: services talk over the compose network on the
# container port. All bind to 127.0.0.1.
#   POSTGRES_HOST_PORT=5432
#   REDIS_HOST_PORT=6379
#   RABBITMQ_HOST_PORT=5672
#   RABBITMQ_UI_HOST_PORT=15672
#   MAILHOG_SMTP_HOST_PORT=1025
#   MAILHOG_UI_HOST_PORT=8025

# --- Timeout budget ---
# Outermost to innermost: caddy 30s (its default) > service HTTP server (this)
# > internal service-to-service client 10s (INTERNAL_CLIENT_TIMEOUT_SECONDS).
# An inner timeout that outlives its caller turns one slow hop into two.
REQUEST_TIMEOUT_SECONDS=20

# --- Database pool (per service) ---
# Every service shares one Postgres (default max_connections=100). The number
# of services with a database x DB_MAX_CONNS must stay below that, with room
# for migrations and psql.
DB_MAX_CONNS=10

# --- Initial admin (created on first startup) ---
ADMIN_EMAIL=admin@university.edu.tr
# Must NOT be the literal "Admin123!" in production.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_password

# --- Demo seed & demo mode ---
# true: on first `up`, the seed service creates demo teachers/courses/students
# via the admin API (idempotent). Set false to skip.
SEED_DEMO=true
# DEMO_MODE=true exposes public demo accounts on login page and creates demo admin.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=demo.admin@mydreamcampus.com
DEMO_TEACHER_EMAIL=ahmet.yilmaz@uni.edu.tr
DEMO_STUDENT_EMAIL=zeynep.sahin@uni.edu.tr
# PROTECTED_ACCOUNT_EMAILS is derived automatically in docker-compose from
# ADMIN_EMAIL and DEMO_*_EMAIL — no need to set manually.

# Baseline settings for demo-ops:
NIGHTLY_RESET_AT=04:00
BASELINE_KEEP=7
BASELINE_OFFSITE_CMD=

# --- Cloudflare Tunnel (EDGE=tunnel) ---
# Token from Cloudflare Zero Trust dashboard (Networks -> Tunnels).
# Required when starting stack with EDGE=tunnel.
TUNNEL_TOKEN=CHANGE_ME_cloudflare_tunnel_token

# --- Outgoing mail (password reset, welcome) ---
# Unset = MailHog: mail is caught locally (UI on 127.0.0.1:8025 with the
# standalone overlay) and never reaches a real inbox — so password reset only
# works for someone who can open MailHog. Point these at a real relay (587 +
# STARTTLS) for the reset flow to work for users.
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USERNAME=
#   SMTP_PASSWORD=
#   SMTP_FROM=noreply@campus.example.com

# --- Public address ---
# PUBLIC_ORIGIN is the full URL the browser uses (CORS + e-mail links); it must
# match PUBLIC_HOST exactly, with no trailing slash.
#
# A) Home server / LAN — keep the http:// prefix on PUBLIC_HOST. The explicit
#    scheme turns Caddy's automatic HTTPS off, which is what you want: Let's
#    Encrypt cannot issue a cert for a private IP. Use the server's LAN IP
#    (`hostname -I`), not localhost, or no other device can reach it.
#      PUBLIC_HOST=http://192.168.1.50
#      PUBLIC_ORIGIN=http://192.168.1.50
#
# A2) Rootless Docker, port 80 kullanilamiyorsa — publish on a high port and
#    let Caddy answer for any host (`:80` = listen on 80 inside the container,
#    no host matching). PUBLIC_ORIGIN must carry the port the browser uses.
#      HTTP_PORT=8080
#      HTTPS_PORT=8443
#      PUBLIC_HOST=:80
#      PUBLIC_ORIGIN=http://192.168.1.50:8080
#
# B) Public VPS — hostname only, no scheme. With no domain, use sslip.io with
#    the IP dash-encoded, e.g. 203.0.113.5 -> 203-0-113-5.sslip.io. Caddy then
#    fetches a real Let's Encrypt cert automatically.
#      PUBLIC_HOST=203-0-113-5.sslip.io
#      PUBLIC_ORIGIN=https://203-0-113-5.sslip.io
#
# C) Cloudflare Tunnel (EDGE=tunnel) — Caddy answers for any host on container port 80,
#    Cloudflare terminates TLS and proxies to Caddy.
#      PUBLIC_HOST=:80
#      PUBLIC_ORIGIN=https://campus.example.com
PUBLIC_HOST=http://192.168.1.50
PUBLIC_ORIGIN=http://192.168.1.50

