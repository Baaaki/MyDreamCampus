# Copy to .env and fill in. `docker compose up` reads this file automatically.
# Generate every secret with:  openssl rand -base64 48
# The monolith runs with ENVIRONMENT=production and REFUSES to start if any
# secret is left at its default value.

# --- Postgres (both databases share these credentials) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Redis (token blacklist / rate limit) ---
# Must NOT be the literal "changeme_redis_secret" in production.
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- RabbitMQ ---
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# --- App secrets (each 32+ bytes; openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_bytes
INTERNAL_SERVICE_SECRET=CHANGE_ME_internal_secret_min_32_bytes
QR_SECRET=CHANGE_ME_qr_secret_min_32_bytes

# --- Initial admin (created on first startup) ---
ADMIN_EMAIL=admin@university.edu.tr
# Must NOT be the literal "Admin123!" in production.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_password

# --- Demo seed ---
# true: on first `up`, the seed service creates demo teachers/courses/students
# via the admin API (idempotent). Set false to skip.
SEED_DEMO=true

# --- Public address ---
# PUBLIC_ORIGIN is the full URL the browser uses (CORS + e-mail links); it must
# match PUBLIC_HOST exactly, with no trailing slash.
#
# A) Home server / LAN — keep the http:// prefix on PUBLIC_HOST. The explicit
#    scheme turns Caddy's automatic HTTPS off, which is what you want: Let's
#    Encrypt cannot issue a cert for a private IP. Use the server's LAN IP
#    (`hostname -I`), not localhost, or no other device can reach it.
#      PUBLIC_HOST=http://192.168.1.50
#      PUBLIC_ORIGIN=http://192.168.1.50
#
# B) Public VPS — hostname only, no scheme. With no domain, use sslip.io with
#    the IP dash-encoded, e.g. 203.0.113.5 -> 203-0-113-5.sslip.io. Caddy then
#    fetches a real Let's Encrypt cert automatically.
#      PUBLIC_HOST=203-0-113-5.sslip.io
#      PUBLIC_ORIGIN=https://203-0-113-5.sslip.io
PUBLIC_HOST=http://192.168.1.50
PUBLIC_ORIGIN=http://192.168.1.50
