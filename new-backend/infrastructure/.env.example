POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydreamcampus

# Must match the monolith's REDIS_PASSWORD (see ../monolith/.env.example).
REDIS_PASSWORD=changeme_redis_secret

# Must match the credentials embedded in the monolith's RABBITMQ_URL.
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
