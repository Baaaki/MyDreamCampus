  {
    "course_code": "ATA 1001",
    "name": "Atatürk İlkeleri ve İnkılap Tarihi I",
    "faculty": "Fen Fakültesi",
    "department": "Bilgisayar Bilimleri",
    "offering_unit": "Atatürk İlkeleri ve İnkılap Tarihi Enstitüsü",
    "class_level": 1,
    "semester": 1,
    "credits": 2,
    "ects": 2,
    "theoretical_hours": 2,
    "lab_hours": 0,
    "course_type": "mandatory",
    "education_level": "undergraduate",
    "teaching_type": "on_campus",
    "language": "Türkçe",
    "coordinator": {
      "title": "Prof. Dr.",
      "name": "Fevzi Çakmak",
      "email": "fevzi.cakmak@uni.edu.tr",
      "phone": "(0850) 000 00 00",
      "office": "Atatürk İlkeleri ve İnkılap Tarihi Enstitüsü, Merkez Yerleşke"
    },
    "purpose": "İmparatorluktan milli devlete geçişte, Türk toplumunun gelişim aşamalarını öğrencilere kavratmak",
    "description": "İmparatorluktan milli devlete geçişte, Türk toplumunun gelişim aşamalarını öğrencilere kavratmak",
    "learning_outcomes_list": [
      "Türk devriminin temelini oluşturan genel kavramları ana hatlarıyla izah edebilme",
      "Osmanlı Devleti'nin batılılaşma hareketlerinin amaç, yöntem ve sonuçlarını anlatabilme",
      "Osmanlı Devleti'nin son döneminde yaşanan iç ve dış politikadaki gelişmeleri kavrayabilme",
      "Birinci Dünya Savaşı'nın Osmanlı Devleti'ne etkilerini anlayabilme",
      "Milli Mücadele sürecinde yaşanan siyasi, askeri, ekonomik ve toplumsal olayları iredeleyebilme"
    ],
    "weekly_topics": [
      {
        "week": 1,
        "topic": "Kavramlar: Devlet, Monarşi, Oligarşi, Cumhuriyet, Laiklik, Demokrasi, İhtilal, Devrim, Ulus-devlet"
      },
      {
        "week": 2,
        "topic": "Batı Modernleşme Tarihi: Feodalizm, Haçlı Seferleri, Coğrafi Keşifler, Rönesans ve Reform Hareketleri, Fransız İhtilali, Sanayi Devrimi"
      },
      {
        "week": 3,
        "topic": "Osmanlı-Türk Modernleşmesi (1876 yılı Meşrutiyet'in İlanına Kadar)"
      },
      {
        "week": 4,
        "topic": "Osmanlı-Türk Modernleşmesi (II. Meşrutiyet Dönemi Sonuna Kadar-1918)"
      },
      {
        "week": 5,
        "topic": "19. Yüzyıldan 20. Yüzyıla uluslararası arenada yaşanan rekabet ve bunun Osmanlı Devleti'ne yansımaları: Emperyalizm, sömürgecilik, milliyetçilik ve bloklaşma"
      },
      {
        "week": 6,
        "topic": "Trablusgarp ve Balkan Savaşları"
      },
      {
        "week": 7,
        "topic": "Birinci Dünya Savaşı'na Gidilen Süreç ve Osmanlı Devleti"
      },
      {
        "week": 8,
        "topic": "Birinci Dünya Savaşı'nda Cepheler"
      },
      {
        "week": 9,
        "topic": "Mondros Ateşkes Antlaşması ve işgal süreci"
      },
      {
        "week": 10,
        "topic": "Birinci Dünya Savaşı Sonrası Anadolu'da Mevcut Durum, Yaşanan Gelişmeler ve Kuva-yı Milliye Hareketi"
      },
      {
        "week": 11,
        "topic": "Mustafa Kemal Atatürk'ün Samsun'a Çıkışı ve Milli Mücadelenin Örgütlenme Süreci: Kongreler"
      },
      {
        "week": 12,
        "topic": "Türkiye Büyük Millet Meclisi'nin Açılması ve Yasama Faaliyetleri"
      },
      {
        "week": 13,
        "topic": "Düzenli Ordunun Kurulması ve Askeri Mücedele Safhası: Doğu, Güney ve Batı Cephesinde Yaşanan Askeri Gelişmeler"
      },
      {
        "week": 14,
        "topic": "30 Ağustos Büyük Taarruz ve Mudanya Ateşkes Antlaşması"
      }
    ],
    "recommended_sources": [
      "Mustafa Kemal Atatürk, Nutuk",
      "Kemal Arı, Başlangıçtan Günümüze Türk Devrim Tarihi",
      "Ahmet Mumcu, Atatürk İlkeleri ve İnkılâp Tarihi-1",
      "Ergun Aybars, Türkiye Cumhuriyeti Tarihi",
      "Türkiye Cumhuriyeti Tarihi-I (Komisyon), Atatürk Araştırma Merkezi Yay.",
      "İlber Ortaylı, İmparatorluğun En Uzun Yüzyılı",
      "Ahmet Mumcu, Tarih Açısından Türk Devriminin Temelleri ve Gelişimi",
      "Şerafettin Turan, Türk Devrim Tarihi",
      "Niyazi Berkes, Türkiye'de Çağdaşlaşma"
    ],
