# Installed to ~/.config/systemd/user/ by `make autodeploy-install`, which
# substitutes @REPO@. A *user* unit, not a system one: it deploys as the user
# who owns the checkout. auto-deploy.sh finds the Docker socket itself, so the
# same unit works with rootless Docker and with a rootful daemon reached
# through the docker group.
[Unit]
Description=MyDreamCampus auto-deploy (poll origin and rebuild on change)
After=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/auto-deploy.sh

# A hung build must not block every later tick.
TimeoutStartSec=30min
